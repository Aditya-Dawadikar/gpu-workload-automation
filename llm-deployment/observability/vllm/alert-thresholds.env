# Thresholds for the vLLM alert rules (vllm-alerts.yml.tmpl). scripts/render_alerts.py
# fills them in; an environment variable of the same name overrides a value here, e.g.
#   VLLM_ALERT_TTFT_P95_SECONDS=1 ./scripts/deploy.sh
# Durations use Prometheus syntax (30s, 5m, 1h).

# --- Availability: workload-independent -------------------------------------
# A replica's /metrics endpoint failing to scrape (Prometheus `up` == 0).
VLLM_ALERT_TARGET_DOWN_FOR=2m
# Serve has RUNNING replicas whose metrics no endpoint is serving.
VLLM_ALERT_MISSING_METRICS_FOR=5m
# Replicas Serve reports in a state other than RUNNING. Loading a model takes a
# few minutes (longer on first download), so keep this above your load time.
VLLM_ALERT_NOT_RUNNING_FOR=15m

# --- Queueing: tune to your workload ----------------------------------------
# Requests waiting in one replica's vLLM scheduler queue, sustained. vLLM only
# queues once max_num_seqs or the KV cache is full; requests beyond
# max_ongoing_requests wait in Ray Serve instead, which this does not see.
VLLM_ALERT_QUEUE_WAITING=8
VLLM_ALERT_QUEUE_FOR=5m

# --- Latency: tune to your model, GPU, prompt and output lengths ------------
# Fleet p95 from summed histogram buckets over 5m. Each must stay below the
# metric's highest finite bucket (TTFT 10s, inter-token 2.5s, end-to-end 60s);
# render_alerts.py refuses values that couldn't fire.
VLLM_ALERT_TTFT_P95_SECONDS=2
VLLM_ALERT_ITL_P95_SECONDS=0.2
# End-to-end time grows with max_tokens: set it from your typical output length.
VLLM_ALERT_E2E_P95_SECONDS=30
VLLM_ALERT_LATENCY_FOR=10m
# Below this many finished requests/s, latency alerts stay quiet: a handful of
# requests makes a noisy p95, and no traffic gives no p95 at all.
VLLM_ALERT_MIN_REQUEST_RATE=0.05

# --- KV-cache pressure: tune to your workload --------------------------------
# Preemptions/s per replica (requests evicted from the KV cache and recomputed).
VLLM_ALERT_PREEMPTION_RATE=0.01
VLLM_ALERT_PREEMPTION_FOR=10m
